msgstr[0] "%(counter)s ta natija"

msgid "0 of %(cnt)s selected"
msgstr "%(cnt)s tadan 0 tasi tanlandi"

msgid "%(total_count)s selected"
msgid_plural "All %(total_count)s selected"
msgstr[0] "%(total_count)s ta tanlandi"

msgid "Click here to select the objects across all pages"
msgstr "Barcha sahifalardagi obyektlarni tanlash uchun bosing"

msgid "Select all %(total_count)s %(module_name)s"
msgstr "Barchasini tanlash: %(total_count)s ta %(module_name)s"

msgid "Clear selection"
msgstr "Tanlovni bekor qilish"

msgid "Select all objects on this page for an action"
msgstr "Sahifadagi barcha obyektlarni tanlash"

msgid "Select this object for an action - {}"
msgstr "Amal uchun tanlash — {}"

msgid "Delete selected %(verbose_name_plural)s"
msgstr "Tanlangan %(verbose_name_plural)sni o‘chirish"

msgid "Items must be selected in order to perform actions on them. No items have been changed."
msgstr "Amal bajarish uchun avval obyektlarni tanlang. Hech narsa o‘zgartirilmadi."

msgid "No action selected."
msgstr "Hech qanday amal tanlanmadi."

msgid "%(count)s %(name)s was changed successfully."
msgid_plural "%(count)s %(name)s were changed successfully."
msgstr[0] "%(count)s ta %(name)s muvaffaqiyatli o‘zgartirildi."

msgid "Successfully deleted %(count)d %(items)s."
msgstr "%(count)d ta %(items)s muvaffaqiyatli o‘chirildi."

msgid "Save as new"
msgstr "Yangi sifatida saqlash"

