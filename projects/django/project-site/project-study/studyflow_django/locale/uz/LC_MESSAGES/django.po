msgstr "Saqlab, davom ettirish"

msgid "Save and view"
msgstr "Saqlab, ko‘rish"

msgid "Close"
msgstr "Yopish"

msgid "History"
msgstr "Tarix"

msgid "View on site"
msgstr "Saytda ko‘rish"

msgid "Please correct the error below."
msgid_plural "Please correct the errors below."
msgstr[0] "Iltimos, quyidagi xatolarni tuzating."

msgid "Hold down “Control”, or “Command” on a Mac, to select more than one."
msgstr "Bir nechtasini tanlash uchun “Control” (Mac’da “Command”) tugmasini bosib turing."

msgid "Change selected %(model)s"
msgstr "Tanlangan %(model)sni o‘zgartirish"

msgid "Add another %(model)s"
msgstr "Yana %(model)s qo‘shish"

msgid "Delete selected %(model)s"
msgstr "Tanlangan %(model)sni o‘chirish"

msgid "View selected %(model)s"
msgstr "Tanlangan %(model)sni ko‘rish"

msgid "The {name} “{obj}” was added successfully."
msgstr "{name} “{obj}” muvaffaqiyatli qo‘shildi."

msgid "The {name} “{obj}” was changed successfully."
msgstr "{name} “{obj}” muvaffaqiyatli o‘zgartirildi."

msgid "You may edit it again below."
msgstr "Uni quyida yana tahrirlashingiz mumkin."

msgid "The {name} “{obj}” was added successfully. You may add another {name} below."
msgstr "{name} “{obj}” muvaffaqiyatli qo‘shildi. Quyida yana qo‘shishingiz mumkin."

msgid "The {name} “{obj}” was changed successfully. You may edit it again below."
msgstr "{name} “{obj}” muvaffaqiyatli o‘zgartirildi. Uni quyida yana tahrirlashingiz mumkin."

msgid "The {name} “{obj}” was changed successfully. You may add another {name} below."
msgstr "{name} “{obj}” muvaffaqiyatli o‘zgartirildi. Quyida yana qo‘shishingiz mumkin."

msgid "%(name)s with ID “%(key)s” doesn’t exist. Perhaps it was deleted?"
msgstr "ID “%(key)s” bo‘lgan %(name)s topilmadi. Ehtimol, u o‘chirilgan."

msgid "Change history: %s"
msgstr "O‘zgarishlar tarixi: %s"

msgid "Date/time"
msgstr "Sana/vaqt"

msgid "User"
msgstr "Foydalanuvchi"

msgid "Action"
msgstr "Amal"

msgid "entry"
msgid_plural "entries"
msgstr[0] "yozuv"

msgid "This object doesn’t have a change history. It probably wasn’t added via this admin site."
msgstr "Bu obyektning o‘zgarishlar tarixi yo‘q. Ehtimol, u admin panel orqali qo‘shilmagan."

msgid "Added."
msgstr "Qo‘shildi."

msgid "Changed {fields}."
msgstr "{fields} o‘zgartirildi."

msgid "No fields changed."
msgstr "Hech qanday maydon o‘zgartirilmadi."

msgid "Added {name} “{object}”."
msgstr "{name} “{object}” qo‘shildi."

msgid "Changed {fields} for {name} “{object}”."
msgstr "{name} “{object}”: {fields} o‘zgartirildi."

msgid "Deleted {name} “{object}”."
msgstr "{name} “{object}” o‘chirildi."

msgid "Objects"
msgstr "Obyektlar"

msgid "Yes, I’m sure"
msgstr "Ha, ishonchim komil"

msgid "No, take me back"
msgstr "Yo‘q, ortga qaytish"

msgid "Delete multiple objects"
msgstr "Bir nechta obyektni o‘chirish"

msgid "Are you sure you want to delete the %(object_name)s \"%(escaped_object)s\"? All of the following related items will be deleted:"
msgstr "%(object_name)s “%(escaped_object)s” o‘chirilsinmi? Quyidagi barcha bog‘liq elementlar ham o‘chiriladi:"

msgid "Are you sure you want to delete the selected %(objects_name)s? All of the following objects and their related items will be deleted:"
msgstr "Tanlangan %(objects_name)s o‘chirilsinmi? Quyidagi barcha obyektlar va ularga bog‘liq elementlar o‘chiriladi:"

msgid "Deleting the %(object_name)s '%(escaped_object)s' would result in deleting related objects, but your account doesn't have permission to delete the following types of objects:"
msgstr "%(object_name)s “%(escaped_object)s” o‘chirilsa, bog‘liq obyektlar ham o‘chadi, lekin sizda quyidagi turdagi obyektlarni o‘chirish huquqi yo‘q:"

msgid "Deleting the %(object_name)s '%(escaped_object)s' would require deleting the following protected related objects:"
msgstr "%(object_name)s “%(escaped_object)s”ni o‘chirish uchun quyidagi himoyalangan bog‘liq obyektlarni ham o‘chirish kerak:"

msgid "Deleting the selected %(objects_name)s would result in deleting related objects, but your account doesn't have permission to delete the following types of objects:"
msgstr "Tanlangan %(objects_name)s o‘chirilsa, bog‘liq obyektlar ham o‘chadi, lekin sizda quyidagi turdagi obyektlarni o‘chirish huquqi yo‘q:"

msgid "Deleting the selected %(objects_name)s would require deleting the following protected related objects:"
msgstr "Tanlangan %(objects_name)sni o‘chirish uchun quyidagi himoyalangan bog‘liq obyektlarni ham o‘chirish kerak:"

msgid "Password change"
msgstr "Parolni o‘zgartirish"

msgid "Your password was changed."
msgstr "Parolingiz o‘zgartirildi."

msgid "Please enter your old password, for security’s sake, and then enter your new password twice so we can verify you typed it in correctly."
msgstr "Xavfsizlik uchun avval eski parolingizni, so‘ng yangi parolni ikki marta kiriting."

msgid "Change my password"
msgstr "Parolimni o‘zgartirish"

msgid "Old password"
msgstr "Eski parol"

msgid "New password"
msgstr "Yangi parol"

msgid "New password confirmation"
msgstr "Yangi parolni tasdiqlang"

msgid "Enter a new password for the user <strong>%(username)s</strong>."
msgstr "<strong>%(username)s</strong> foydalanuvchisi uchun yangi parol kiriting."

