msgstr "Bugun saytga vaqt ajratganingiz uchun rahmat."

msgid "You are authenticated as %(username)s, but are not authorized to access this page. Would you like to login to a different account?"
msgstr "Siz %(username)s sifatida kirgansiz, lekin bu sahifaga kirish huquqingiz yo‘q. Boshqa akkaunt bilan kirmoqchimisiz?"

msgid "Forgotten your login credentials?"
msgstr "Login yoki parolni unutdingizmi?"

msgid "Select %s to change"
msgstr "O‘zgartirish uchun %s tanlang"

msgid "Select %s to view"
msgstr "Ko‘rish uchun %s tanlang"

