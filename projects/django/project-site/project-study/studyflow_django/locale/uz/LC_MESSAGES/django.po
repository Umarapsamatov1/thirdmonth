msgstr "Ushbu foydalanuvchi uchun alohida ruxsatlar."

msgid "Reset password"
msgstr "Parolni tiklash"

msgid "Set password"
msgstr "Parol o‘rnatish"

msgid "Set password: %s"
msgstr "Parol o‘rnatish: %s"

msgid "No password set."
msgstr "Parol o‘rnatilmagan."

msgid "Invalid password format or unknown hashing algorithm."
msgstr "Parol formati noto‘g‘ri yoki xeshlash algoritmi noma’lum."

